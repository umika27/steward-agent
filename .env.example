# Active Image Generation Provider: 'mock' (default offline mock) or 'ai' (Google Gemini/Imagen AI)
VITE_IMAGE_GENERATION_PROVIDER=mock

# Active Vision Provider: 'mock' (default offline mock) or 'ai' (Google Gemini Multimodal AI)
VITE_VISION_PROVIDER=mock

# Active Reasoning Provider: 'mock' (default offline mock) or 'ai' (Google Gemini AI)
VITE_REASONING_PROVIDER=mock

# Google Gemini / Vision API Key (Required ONLY when using 'ai' provider mode)
# Obtain from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Gemini Model Name (default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
